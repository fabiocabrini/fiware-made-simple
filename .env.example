# FIWARE Made Simple - copy to .env and change the passwords:
#   cp .env.example .env

# --- Image versions (tested together) ---
# MongoDB 8.0 does not start on Linux kernel 6.19 or newer (Ubuntu 26.04): use 8.2
MONGO_VERSION=8.2
ORION_VERSION=4.5.0
IOTA_UL_VERSION=3.7.0
STH_VERSION=2.11.0
MOSQUITTO_VERSION=2.0.22

# --- Historical MongoDB (STH-Comet) ---
# Database administrator (use for administration only)
STH_MONGO_ROOT_USER=admin
STH_MONGO_ROOT_PASSWORD=change-this-admin-password
# STH-Comet user (read and write)
STH_MONGO_USER=sth
STH_MONGO_PASSWORD=change-this-sth-password
# Read-only user for external access (Compass, Python, BI...)
STH_MONGO_READER_USER=reader
STH_MONGO_READER_PASSWORD=change-this-reader-password
# Interface where port 27017 is published. 0.0.0.0 = external access;
# 127.0.0.1 = this machine only (connect through an SSH tunnel).
STH_MONGO_BIND=0.0.0.0

# --- History retention (STH-Comet) ---
# Deletes raw values older than N seconds. 0 = never delete.
# Examples: 604800 = 7 days; 2592000 = 30 days. Applies to new collections.
STH_EXPIRE_AFTER_SECONDS=0

# --- Log level (DEBUG, INFO, WARN, ERROR) ---
ORION_LOG_LEVEL=INFO
IOTA_LOG_LEVEL=INFO
STH_LOG_LEVEL=INFO
