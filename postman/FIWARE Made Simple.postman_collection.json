{
  "info": {
    "_postman_id": "27447f8b-008a-5b36-b688-641d7d15b27c",
    "name": "FIWARE Made Simple",
    "description": "Collection of **FIWARE Made Simple** (https://github.com/fabiocabrini/fiware-made-simple) for the Smart Lamp PoC.\n\n**Before you start:** in the *Variables* tab of this collection, set `url` to the IP address or name of the server where the platform is running.\n\n**Suggested path:**\n0. Health Check\n1. Orion Context Broker (optional, no device)\n2. Provisioning: service group, device, and subscription (once)\n3. Simulate the device, or power on the ESP32\n4. Commands\n5. History in STH-Comet\n6. Cleanup\n\nTested with Orion 4.5.0, IoT Agent UltraLight 3.7.0, and STH-Comet 2.11.0.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health Check",
      "description": "Checks that the platform components are up. Run it before you start.",
      "item": [
        {
          "name": "0.1 Orion Context Broker version",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://{{url}}:1026/version",
            "description": "Returns the version and build information of the Orion Context Broker (port 1026)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Orion responded\", () => pm.expect(pm.response.json().orion.version).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 IoT Agent UltraLight version",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://{{url}}:4041/iot/about",
            "description": "Returns the version of the IoT Agent UltraLight 2.0 (provisioning API, port 4041)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 STH-Comet version",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://{{url}}:8666/version",
            "description": "Returns the version of STH-Comet (short-term history, port 8666)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Orion Context Broker (NGSI-v2)",
      "description": "Basic operations on entities directly in Orion, with no physical device.\n\nOrion stores only the **current state** of each entity. The history lives in STH-Comet (folder 5).\n\nEvery request uses the `fiware-service` header (tenant, which becomes the `orion-<service>` database in MongoDB) and the `fiware-servicepath` header (a subdivision inside the tenant).",
      "item": [
        {
          "name": "1.1 Create entity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities",
            "description": "Creates the entity `urn:ngsi-ld:Sensor:001` of type `Sensor` with the `temperature` and `humidity` attributes.\n\nIn NGSI-v2 every attribute has a `type` and a `value`. Use the `Number` type for numbers.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"urn:ngsi-ld:Sensor:001\",\n  \"type\": \"Sensor\",\n  \"temperature\": {\n    \"type\": \"Number\",\n    \"value\": 23.5\n  },\n  \"humidity\": {\n    \"type\": \"Number\",\n    \"value\": 60\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 List entities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities",
            "description": "Lists all the entities of the given `fiware-service` (20 by default; use `?limit=` and `?offset=` to paginate)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Get entity (keyValues)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/urn:ngsi-ld:Sensor:001?options=keyValues",
            "description": "Returns the entity in the simplified `keyValues` format (name: value only), which is easier to consume in applications."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"temperature present\", () => pm.expect(pm.response.json()).to.have.property(\"temperature\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Update attributes (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/urn:ngsi-ld:Sensor:001/attrs",
            "description": "Updates **existing** attributes. PATCH fails if an attribute does not exist; to add new attributes, use `POST /attrs`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"temperature\": {\n    \"type\": \"Number\",\n    \"value\": 35\n  },\n  \"humidity\": {\n    \"type\": \"Number\",\n    \"value\": 40\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Update a single attribute value",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              },
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/urn:ngsi-ld:Sensor:001/attrs/temperature/value",
            "description": "Replaces only the value of `temperature`. The body is the raw value, sent with `Content-Type: text/plain`.",
            "body": {
              "mode": "raw",
              "raw": "38",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Filter entities (q)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities?type=Sensor&q=temperature>30&options=keyValues",
            "description": "Filtered query: entities of type `Sensor` with `temperature` greater than 30. Other operators: `==`, `!=`, `<`, `<=`, `>=`, `..` (range), and `;` (logical AND)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"filter returned the entity\", () => pm.expect(pm.response.json().length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 Delete entity",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/urn:ngsi-ld:Sensor:001",
            "description": "Deletes the sample entity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Provisioning (run once)",
      "description": "The IoT Agent UltraLight 2.0 translates device messages (MQTT or HTTP) into NGSI-v2 in Orion and forwards Orion commands to the devices.\n\nOrder: create the **service group** once per `fiware-service`, provision each **device**, and create the **subscription** that feeds the history in STH-Comet.",
      "item": [
        {
          "name": "2.1 Create service group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:4041/iot/services",
            "description": "Creates the service group with the API key `{{apikey}}`.\n\n- `apikey`: identifies the group in the MQTT topics (`/<apikey>/<device_id>/attrs`).\n- `resource`: path used by HTTP measurements (port 7896). It must be `/iot/d`.\n- `entity_type`: default type of the entities created for the devices of this group.\n- `autoprovision: false`: messages from devices that are **not provisioned** are discarded. Without it, a device that is powered on before step 2.3 makes the IoT Agent create a \"ghost\" device with the wrong entity name, and provisioning starts to fail.\n\nThe `apikey` is unique across the whole platform: if another group already uses it, even in another `fiware-service`, this step returns 409. Choose another `apikey`.\n\nThere is no need to set `cbroker`: the IoT Agent already knows Orion through the `IOTA_CB_HOST` variable in docker-compose.\n\nRun it **only once**: running it again returns 409 (`DUPLICATE_GROUP`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"services\": [\n    {\n      \"apikey\": \"{{apikey}}\",\n      \"resource\": \"/iot/d\",\n      \"entity_type\": \"{{entity_type}}\",\n      \"autoprovision\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 List service groups",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:4041/iot/services",
            "description": "Lists the service groups of the `fiware-service`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"at least one group exists\", () => pm.expect(pm.response.json().count).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Provision the Smart Lamp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:4041/iot/devices",
            "description": "Provisions the device `{{device_id}}`, which becomes the entity `{{entity_id}}` in Orion.\n\n- `apikey`: **required**. Without it, IoT Agent 3.x does not match measurements to this device.\n- `transport`: `MQTT` makes commands go through the MQTT broker.\n- `commands`: accepted commands (`on`, `off`). The IoT Agent automatically creates in Orion the *registration* that forwards the commands to it; there is no manual step.\n- `attributes`: maps the short `object_id` sent by the device (`s`, `l`) to the attribute name in Orion (`state`, `luminosity`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"devices\": [\n    {\n      \"device_id\": \"{{device_id}}\",\n      \"apikey\": \"{{apikey}}\",\n      \"entity_name\": \"{{entity_id}}\",\n      \"entity_type\": \"{{entity_type}}\",\n      \"protocol\": \"PDI-IoTA-UltraLight\",\n      \"transport\": \"MQTT\",\n      \"commands\": [\n        {\n          \"name\": \"on\",\n          \"type\": \"command\"\n        },\n        {\n          \"name\": \"off\",\n          \"type\": \"command\"\n        }\n      ],\n      \"attributes\": [\n        {\n          \"object_id\": \"s\",\n          \"name\": \"state\",\n          \"type\": \"Text\"\n        },\n        {\n          \"object_id\": \"l\",\n          \"name\": \"luminosity\",\n          \"type\": \"Integer\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 List devices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:4041/iot/devices",
            "description": "Lists the devices provisioned in the `fiware-service`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"device provisioned\", () => pm.expect(pm.response.json().devices.map(d => d.device_id)).to.include(pm.variables.get(\"device_id\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Get the command registration",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/registrations",
            "description": "Shows the registration created automatically by the IoT Agent: it is what makes Orion forward the `on`/`off` commands to the IoT Agent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"registration created by the IoT Agent\", () => pm.expect(JSON.stringify(pm.response.json())).to.include(pm.variables.get(\"entity_id\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Create subscription to STH-Comet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/subscriptions",
            "description": "Notifies STH-Comet of every change of `luminosity`.\n\n**Why `httpCustom`?** STH-Comet only understands notifications in the old NGSIv1 format, and Orion 4.x removed `\"attrsFormat\": \"legacy\"`. With `httpCustom` the NGSIv1 payload is built explicitly; Orion replaces `${id}`, `${type}`, and `${luminosity}` with the real values (Postman leaves them alone, because its variables use double braces).\n\n**Internal URL:** `{{sth_notify_url}}` (`http://sth-comet:8666/notify`). The notification is sent by the Orion container, which reaches STH-Comet by its service name on the Docker network. Do not use the public IP.\n\nTo store another attribute (for example, `state`), create **another subscription** with the same body, replacing `luminosity` with the new attribute. Do not put two attributes in the same subscription: every notification would carry both, and an attribute that did not change would be stored again, duplicated.\n\nRun it **only once**: each run creates a new subscription, and the history starts receiving duplicated values.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Notify STH-Comet of all luminosity changes\",\n  \"subject\": {\n    \"entities\": [\n      {\n        \"id\": \"{{entity_id}}\",\n        \"type\": \"{{entity_type}}\"\n      }\n    ],\n    \"condition\": {\n      \"attrs\": [\n        \"luminosity\"\n      ]\n    }\n  },\n  \"notification\": {\n    \"httpCustom\": {\n      \"url\": \"{{sth_notify_url}}\",\n      \"json\": {\n        \"contextResponses\": [\n          {\n            \"contextElement\": {\n              \"id\": \"${id}\",\n              \"type\": \"${type}\",\n              \"isPattern\": \"false\",\n              \"attributes\": [\n                {\n                  \"name\": \"luminosity\",\n                  \"type\": \"Integer\",\n                  \"value\": \"${luminosity}\"\n                }\n              ]\n            },\n            \"statusCode\": {\n              \"code\": \"200\",\n              \"reasonPhrase\": \"OK\"\n            }\n          }\n        ]\n      }\n    },\n    \"attrs\": [\n      \"luminosity\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const loc = pm.response.headers.get(\"Location\");",
                  "if (loc) pm.collectionVariables.set(\"subscription_id\", loc.split(\"/\").pop());"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Simulate the device (no hardware)",
      "description": "Sends measurements as if it were the ESP32, using the HTTP interface of the IoT Agent (port 7896).\n\nThe real ESP32 publishes the same content over MQTT:\n- `/<apikey>/<device_id>/attrs` with `s|on|l|42` (several attributes), or\n- `/<apikey>/<device_id>/attrs/l` with `42` (a single attribute).",
      "item": [
        {
          "name": "3.1 Send measurement (UltraLight over HTTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": "http://{{url}}:7896/iot/d?k={{apikey}}&i={{device_id}}",
            "description": "Sends `state` and a random `luminosity` (0 to 100) in the UltraLight 2.0 format: `object|value|object|value`.\n\nRun it several times to build up history in STH-Comet (the subscription from step 2.6 must exist).",
            "body": {
              "mode": "raw",
              "raw": "s|off|l|{{luminosity}}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"luminosity\", Math.floor(Math.random() * 101));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Read luminosity in Orion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/{{entity_id}}/attrs/luminosity",
            "description": "Reads the current value of `luminosity` in Orion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"luminosity is a number\", () => pm.expect(pm.response.json().value).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Read state in Orion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/{{entity_id}}/attrs/state",
            "description": "Reads the current value of `state` (LED state reported by the device)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Commands",
      "description": "Commands follow this path: application → Orion → (registration) → IoT Agent → MQTT `/<apikey>/<device_id>/cmd` → device.\n\nThe device must confirm by publishing on `/<apikey>/<device_id>/cmdexe` (for example, `lamp001@on|ok`). Until it confirms, `on_status` stays `PENDING`; then it becomes `OK` and `on_info` receives the text sent.",
      "item": [
        {
          "name": "4.1 Turn the Smart Lamp on",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/{{entity_id}}/attrs",
            "description": "Sends the `on` command. The device receives the message `{{device_id}}@on|` on the `/{{apikey}}/{{device_id}}/cmd` topic.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"on\": {\n    \"type\": \"command\",\n    \"value\": \"\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Turn the Smart Lamp off",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/{{entity_id}}/attrs",
            "description": "Sends the `off` command. The device receives `{{device_id}}@off|`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"off\": {\n    \"type\": \"command\",\n    \"value\": \"\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Check command status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/{{entity_id}}?attrs=on_status,on_info,off_status,off_info&options=keyValues",
            "description": "Shows the execution status of the commands: `PENDING` (waiting for the device), `OK` (confirmed via `cmdexe`), or `ERROR`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"command status present\", () => pm.expect(pm.response.json()).to.have.property(\"on_status\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. History (STH-Comet)",
      "description": "STH-Comet builds the history from **notifications** sent by Orion. The subscription tells Orion: \"when `luminosity` changes, let STH-Comet know\".\n\nThe subscription is created in step 2.6; here you follow the notifications and query the history.",
      "item": [
        {
          "name": "5.1 List subscriptions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/subscriptions",
            "description": "Lists the subscriptions. Under `notification`, check `timesSent` (notifications sent), `lastSuccessCode` (should be 200), and `lastFailureReason` (reason for the last failure)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().find(s => s.id === pm.collectionVariables.get(\"subscription_id\"));",
                  "if (s) pm.test(\"subscription active\", () => pm.expect(s.status).to.eql(\"active\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 History: last N values",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:8666/STH/v1/contextEntities/type/{{entity_type}}/id/{{entity_id}}/attributes/luminosity?lastN={{lastN}}",
            "description": "Returns the last `{{lastN}}` raw values of `luminosity` (maximum 100) with the time they were received (`recvTime`, in UTC)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const values = pm.response.json().contextResponses[0].contextElement.attributes[0].values;",
                  "pm.test(\"history has values\", () => pm.expect(values.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.3 History: paginated by period",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:8666/STH/v1/contextEntities/type/{{entity_type}}/id/{{entity_id}}/attributes/luminosity?hLimit=100&hOffset=0&dateFrom={{dateFrom}}",
            "description": "Values since `dateFrom` (ISO 8601, UTC), in pages of `hLimit` items (maximum 100) starting at `hOffset`. Use `dateTo` to set the end of the period.\n\nThe pre-request script sets `dateFrom` to one hour ago."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"dateFrom\", new Date(Date.now() - 3600 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.4 Aggregated history (maximum per minute)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:8666/STH/v1/contextEntities/type/{{entity_type}}/id/{{entity_id}}/attributes/luminosity?aggrMethod=max&aggrPeriod=minute",
            "description": "Aggregation computed by STH-Comet for numeric attributes.\n\n- `aggrMethod`: `max`, `min`, `sum`, `sum2`, or `occur` (count of text values).\n- `aggrPeriod`: `minute`, `hour`, or `day` (the resolutions computed by default)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Cleanup",
      "description": "Removes everything that was created, in reverse order. Careful: it deletes the data of the configured `fiware-service`.",
      "item": [
        {
          "name": "6.1 Delete subscription",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/subscriptions/{{subscription_id}}",
            "description": "Deletes the subscription created in 2.6 (its id was saved automatically in the `subscription_id` variable). If needed, copy the id from 5.1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Delete history in STH-Comet",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:8666/STH/v1/contextEntities/type/{{entity_type}}/id/{{entity_id}}",
            "description": "Deletes the whole history of the entity in STH-Comet."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.3 Delete device in the IoT Agent",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:4041/iot/devices/{{device_id}}",
            "description": "Removes the device from the IoT Agent. The entity in Orion still exists (step 6.4)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.4 Delete entity in Orion",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:1026/v2/entities/{{entity_id}}",
            "description": "Removes the Smart Lamp entity from Orion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.5 Delete service group",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": "http://{{url}}:4041/iot/services/?resource=/iot/d&apikey={{apikey}}",
            "description": "Removes the service group. Do this only if no other device uses this API key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "url",
      "value": "localhost",
      "description": "IP address or name of the platform server"
    },
    {
      "key": "service",
      "value": "smart",
      "description": "fiware-service (tenant)"
    },
    {
      "key": "servicepath",
      "value": "/",
      "description": "fiware-servicepath"
    },
    {
      "key": "apikey",
      "value": "TEF",
      "description": "API key of the service group"
    },
    {
      "key": "device_id",
      "value": "lamp001",
      "description": "Device identifier in the IoT Agent and in the MQTT topics"
    },
    {
      "key": "entity_id",
      "value": "urn:ngsi-ld:Lamp:001",
      "description": "Entity id in Orion"
    },
    {
      "key": "entity_type",
      "value": "Lamp",
      "description": "Entity type in Orion"
    },
    {
      "key": "sth_notify_url",
      "value": "http://sth-comet:8666/notify",
      "description": "INTERNAL URL (Docker network) used by Orion to notify STH-Comet"
    },
    {
      "key": "lastN",
      "value": "30",
      "description": "Number of values returned by the history (maximum 100)"
    },
    {
      "key": "subscription_id",
      "value": "",
      "description": "Filled in automatically in 2.6"
    }
  ]
}
